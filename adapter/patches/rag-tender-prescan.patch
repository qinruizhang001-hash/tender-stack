+# --- 确定性扫描层前置（可选，环境变量开启；不设置则行为与上游完全一致）---
+# 只读一个 JSON 文件，不依赖任何外部项目代码，属于数据流对接。
+_PRESCAN_CACHE: dict[str, Any] | None = None
+
+
+def prescan_payload() -> dict[str, Any]:
+    global _PRESCAN_CACHE
+    if _PRESCAN_CACHE is not None:
+        return _PRESCAN_CACHE
+    path = os.environ.get("TENDER_PRESCAN_JSON", "")
+    if not path:
+        _PRESCAN_CACHE = {}
+        return _PRESCAN_CACHE
+    try:
+        _PRESCAN_CACHE = json.loads(Path(path).read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        _PRESCAN_CACHE = {}
+    return _PRESCAN_CACHE
+
 
